Screen {
    background: $background;
    color: $foreground;
}

#top-bar {
    height: 1;
    background: $background;
    padding: 0 2;
    margin: 1 0;
}

#git-branch {
    width: auto;
    height: 1;
    color: $foreground;
    text-style: dim;
    padding: 0 1 0 0;
}

#worktree-flag {
    width: auto;
    height: 1;
    color: $accent;
    padding: 0 1 0 0;
}

#cwd {
    color: $text-muted;
    width: 1fr;
    height: 1;
    overflow: hidden;
    text-overflow: ellipsis;
}

#model-label {
    width: auto;
    height: 1;
    color: $text-muted;
    content-align: right middle;
}

#mode-flag {
    display: none;
    width: auto;
    height: 1;
    color: $accent;
    padding: 0 0 0 1;
    content-align: right middle;
}

#chat {
    height: 1fr;
    padding: 0 2;
}

Welcome {
    width: 72;
    height: auto;
    border: solid $border;
    padding: 1 2;
    margin: 4 0;
    align: center middle;
}

#welcome-title {
    color: $foreground;
    text-style: bold;
}

#welcome-hint {
    color: $accent;
    margin-top: 1;
}

#welcome-menu {
    color: $foreground;
    margin-top: 1;
}

UserMessage {
    height: auto;
    margin: 1 12 0 0;
    padding: 0 1;
    color: $foreground;
}

.user-chips {
    height: auto;
    width: 100%;
}

.file-chip {
    width: auto;
    height: 1;
    background: $surface;
    color: $foreground;
    padding: 0 1;
    margin: 0 1 0 0;
}

.user-body {
    height: auto;
    color: $foreground;
}

Spinner {
    color: $text-muted;
    margin: 0 0 1 0;
    padding: 0 1;
}

AssistantMessage {
    margin: 0 0 1 0;
    padding: 0 1;
}

CopyableFence {
    layout: vertical;
    height: auto;
    padding: 1 0;
    overflow-x: hidden;
    overflow-y: hidden;
}

CopyableFence > #code-content {
    width: 100%;
    height: auto;
    text-wrap: wrap;
    overflow: hidden;
    padding: 0 2;
    margin-top: 1;
}

.fence-bar {
    height: 1;
    width: 100%;
    padding: 0 2;
}

.fence-lang {
    width: 1fr;
    height: 1;
    color: $text-muted;
    content-align: left middle;
}

FenceCopy {
    width: auto;
    height: 1;
    color: $accent;
    text-style: bold;
    padding: 0 0 0 1;
    content-align: right middle;
}

FenceCopy:hover,
FenceCopy:focus {
    background: $accent;
    color: $background;
}

ToolRow {
    height: auto;
    padding: 0 1;
}

.tool-header {
    height: 1;
    color: $text-muted;
}

ToolRow.running > .tool-header {
    color: $accent;
}

ToolRow.done > .tool-header {
    color: $text-muted;
}

ToolRow.error > .tool-header {
    color: $error;
}

ToolRow.subagent {
    padding: 0 1;
}

ToolRow.subagent > .tool-body {
    padding: 0 1 0 2;
}

.tool-body {
    height: auto;
    color: $text-muted;
    padding: 0 2;
}

ToolFold {
    color: $text-muted;
    height: 1;
    padding: 0 1;
}

ToolFold:focus {
    color: $foreground;
    text-style: bold;
}

DiffBlock {
    padding: 0 0 1 1;
    height: auto;
}

DiffFold {
    color: $text-muted;
    height: 1;
    padding: 0 1;
}

DiffFold:focus {
    color: $foreground;
    text-style: bold;
}

ErrorBlock {
    height: auto;
    margin: 1 0 0 0;
    padding: 0 0 1 1;
    border-left: wide $error;
}

ErrorBlock > Static {
    height: auto;
}

.error-header {
    color: $text-muted;
    height: 1;
}

.error-message {
    color: $text-error;
    padding: 0 1;
}

.error-body {
    color: $text-muted;
    padding: 0 1;
    margin-top: 1;
}

ErrorFold {
    color: $text-muted;
    height: 1;
    padding: 0 1;
}

ErrorFold:focus {
    color: $foreground;
    text-style: bold;
}

SystemNote {
    color: $text-muted;
    padding: 0 1;
    margin: 1 0;
}

#prompt-bar {
    height: auto;
    dock: bottom;
}

#prompt-row {
    height: auto;
    border: round $border;
    padding: 0 1;
}

#prompt-prefix {
    width: 2;
    height: 1;
    color: $accent;
    content-align: left top;
}

#prompt {
    background: $background;
    color: $foreground;
    border: none;
    padding: 0;
    width: 1fr;
    height: auto;
    min-height: 1;
    max-height: 8;
}

#prompt:focus {
    border: none;
}

#prompt .text-area--cursor-line {
    background: $background;
}

Autocomplete {
    display: none;
    max-height: 10;
    height: auto;
    border: solid $border;
    background: $background-darken-1;
    padding: 0;
}

Autocomplete > .option-list--option-highlighted {
    background: $surface;
    color: $foreground;
}

PlanBar {
    display: none;
    height: auto;
    background: $background;
    border-top: solid $surface;
    padding: 1 2;
}

PlanDoc {
    margin: 0 0 1 0;
    padding: 0 1;
}

#plan-summary {
    color: $text-muted;
    margin-bottom: 1;
    height: auto;
}

#plan-options {
    height: auto;
    max-height: 5;
    border: none;
    background: $background;
    padding: 0;
}

#plan-options > .option-list--option-highlighted {
    background: $background;
}

PermissionPicker {
    display: none;
    height: auto;
    background: $background;
    border-top: solid $surface;
    padding: 1 2;
}

#permission-summary {
    color: $text-muted;
    margin-bottom: 1;
}

#permission-options {
    height: auto;
    max-height: 5;
    border: none;
    background: $background;
    padding: 0;
}

#permission-options > .option-list--option-highlighted {
    background: $background;
}

QuestionBar {
    display: none;
    height: auto;
    background: $background;
    border-top: solid $surface;
    padding: 1 2;
}

#question-summary {
    color: $text-muted;
    margin-bottom: 1;
}

#question-options {
    height: auto;
    max-height: 8;
    border: none;
    background: $background;
    padding: 0;
}

#question-options > .option-list--option-highlighted {
    background: $background;
}

#question-other-row {
    display: none;
    height: 1;
    layout: horizontal;
    background: $background;
}

#question-other-mark {
    width: auto;
    height: 1;
    padding: 0;
}

#question-other-hint {
    width: 1fr;
    height: 1;
    color: $text-muted;
}

QuestionBar Input,
QuestionBar Input:focus {
    width: 1fr;
    height: 1;
    border: none;
    padding: 0;
    background: $background;
    color: $accent;
}

QuestionBar Input > .input--placeholder {
    color: $text-muted;
}

QuestionBar Input > .input--cursor {
    background: $accent;
    color: $background;
}

.role {
    color: $text-muted;
    text-style: bold;
    padding: 0 1;
    margin-top: 1;
}
