Screen {
    background: #1a1b1e;
    color: #d4d4d4;
}

/* height 2 = 1 de conteúdo + 1 da border-bottom (Textual come a borda da height). */
#top-bar {
    height: 2;
    background: #1a1b1e;
    border-bottom: solid #2a2a2e;
    padding: 0 1;
}

#cwd-icon,
#model-icon {
    width: auto;
    height: 1;
    color: #6e6e6e;
    padding: 0 1 0 0;
}

#cwd {
    color: #9a9a9a;
    width: 1fr;
    height: 1;
}

#model-label {
    width: auto;
    height: 1;
    color: #9a9a9a;
    content-align: right middle;
}

#chat {
    height: 1fr;
    padding: 0 2;
}

Welcome {
    width: 72;
    height: auto;
    border: solid #3a3a3a;
    padding: 1 2;
    margin: 4 0;
    align: center middle;
}

#welcome-title {
    color: #e6e6e6;
    text-style: bold;
}

#welcome-hint {
    color: #c9a227;
    margin-top: 1;
}

#welcome-menu {
    color: #c8c8c8;
    margin-top: 1;
}

UserMessage {
    margin: 1 12 0 0;
    padding: 0 1;
    color: #e6e6e6;
}

AssistantMessage {
    margin: 0 0 1 0;
    padding: 0 1;
}

ToolRow {
    color: #8a8a8a;
    padding: 0 1;
}

ToolRow.running {
    color: #c9a227;
}

ToolRow.done {
    color: #6e6e6e;
}

ToolRow.error {
    color: #c45c5c;
}

SystemNote {
    color: #8a8a8a;
    padding: 0 1;
    margin: 1 0;
}

#prompt-row {
    height: auto;
    dock: bottom;
    border: solid #3a3a3a;
    padding: 0 1;
}

#prompt {
    background: #1a1b1e;
    border: none;
    padding: 0;
    width: 1fr;
}

Autocomplete {
    display: none;
    max-height: 10;
    height: auto;
    border: solid #3a3a3a;
    background: #141414;
    padding: 0;
}

Autocomplete > .option-list--option-highlighted {
    background: #2a2a2a;
    color: #e6e6e6;
}

PermissionPicker {
    display: none;
    height: auto;
    background: #1a1b1e;
    border-top: solid #2a2a2e;
    padding: 1 2;
}

#permission-summary {
    color: #9a9a9a;
    margin-bottom: 1;
}

#permission-options {
    height: auto;
    max-height: 5;
    border: none;
    background: #1a1b1e;
    padding: 0;
}

#permission-options > .option-list--option-highlighted {
    background: #1a1b1e;
}

.role {
    color: #6e6e6e;
    text-style: bold;
    padding: 0 1;
    margin-top: 1;
}
